load("//buck2:haskell.bzl", "haskell_library", "haskell_test")
load("//buck2:thrift.bzl", "thrift_srcs")

# Reused by other packages' test-libs (thrift-http today) that generate the
# same Math/Echoer types from these files, the same way the Makefile's
# thrift-hs target re-runs thrift-compiler on them per package (`-o
# ../http/test` etc.) instead of sharing a single generated copy. The
# thrift/annotation/*.thrift files themselves come straight from the
# cell-root exports (//:annotations) instead of a lib-local copy.
export_file(
    name = "math.thrift",
    src = "test/if/math.thrift",
    visibility = ["PUBLIC"],
)

export_file(
    name = "echoer.thrift",
    src = "test/if/echoer.thrift",
    visibility = ["PUBLIC"],
)

haskell_library(
    name = "thrift-lib",
    srcs = thrift_srcs(
        name = "thrift-lib",
        thrift_files = {
        # namespace hs in each .thrift file determines the generated path.
        "if/RpcOptions.thrift": ["Thrift/Protocol/RpcOptions/Types.hs"],
        "if/ApplicationException.thrift": ["Thrift/Protocol/ApplicationException/Types.hs"],
    },
        srcs = [
        "Thrift/Api.hs",
        "Thrift/Binary/Parser.hs",
        "Thrift/Channel.hs",
        "Thrift/Channel/SocketChannel.hs",
        "Thrift/Channel/SocketChannel/Server.hs",
        "Thrift/Codegen.hs",
        "Thrift/CodegenTypesOnly.hs",
        "Thrift/HasFields.hs",
        "Thrift/Monad.hsc",
        "Thrift/Processor.hs",
        "Thrift/Protocol.hs",
        "Thrift/Protocol/Binary.hs",
        "Thrift/Protocol/Binary/Internal.hs",
        "Thrift/Protocol/Compact.hs",
        "Thrift/Protocol/Id.hs",
        "Thrift/Protocol/JSON.hs",
        "Thrift/Protocol/JSON/Base64.hs",
        "Thrift/Protocol/JSON/String.hs",
        "Thrift/Util.hs",
    ],
    ),
    linker_flags = ["-lstdc++"],
    deps = [
        "//common/github:fb-stubs",
        "//common/util:fb-util",
    ],
    packages = [
        "QuickCheck",
        "STMonadTrans",
        "aeson",
        "aeson-pretty",
        "async",
        "bytestring",
        "bytestring-lexing",
        "containers",
        "data-default",
        "deepseq",
        "filepath",
        "ghc",
        "ghc-prim",
        "hashable",
        "hspec",
        "hspec-contrib",
        "network",
        "scientific",
        "some",
        "text",
        "text-show",
        "transformers",
        "unordered-containers",
        "vector",
        "word8",
    ],
    visibility = ["PUBLIC"],
)

haskell_library(
    name = "test-helpers",
    srcs = {
        "Network.hs": "test/helpers/Network.hs",
        "TestChannel.hs": "test/helpers/TestChannel.hs",
    },
    deps = [":thrift-lib"],
    packages = ["bytestring", "network"],
    visibility = ["PUBLIC"],
)

# Shared by test-lib and the test-suites below it (matches the `test-deps`
# common stanza in thrift-lib.cabal).
_TEST_DEPS = [
    ":test-helpers",
    ":thrift-lib",
    "//common/github:fb-stubs",
    "//common/util:fb-util",
]

_TEST_PACKAGES = [
    "HUnit",
    "QuickCheck",
    "STMonadTrans",
    "aeson",
    "async",
    "bytestring",
    "containers",
    "data-default",
    "deepseq",
    "filepath",
    "ghc-prim",
    "hashable",
    "hspec",
    "hspec-contrib",
    "network",
    "text",
    "transformers",
    "unordered-containers",
    "vector",
]

haskell_library(
    name = "test-lib",
    srcs = thrift_srcs(
        name = "test-lib",
        thrift_files = {
        # Each compiled independently here (matching the Makefile's `cd
        # lib && thrift-compiler ...` re-running it per test-suite, no
        # shared library) - see the `deps` below for how their own
        # `include`s of each other resolve.
        "thrift/annotation/thrift.thrift": ["Facebook/Thrift/Annotation/Thrift/Thrift/Types.hs"],
        "thrift/annotation/scope.thrift": ["Scope/Types.hs"],
        "thrift/annotation/haskell.thrift": ["Facebook/Thrift/Annotation/Haskell/Haskell/Types.hs"],
        "test/if/math.thrift": [
            "Math/Types.hs",
            "Math/Adder/Client.hs",
            "Math/Adder/Service.hs",
            "Math/Calculator/Client.hs",
            "Math/Calculator/Service.hs",
        ],
        "test/if/echoer.thrift": [
            "Echoer/Types.hs",
            "Echoer/Echoer/Client.hs",
            "Echoer/Echoer/Service.hs",
        ],
        "//tests:hs_test.thrift": ["HsTest/Types.hs"],
    },
        thrift_flags = [],
        thrift_file_flags = {
        "test/if/math.thrift": ["--use-int"],
    },
        # Every file above sees every other (echoer.thrift's own `include
        # "test/if/math.thrift"` included) for free, since they're all in
        # the same thrift_files dict above - only genuinely external deps
        # (the shared annotations, and hs_test.thrift's own hs_include'd
        # instances file) need listing here.
        deps = ["//:annotations", "//tests:hs_test_instances.hs"],
        srcs = {"TestCommon.hs": "test/lib/TestCommon.hs"},
    ),
    deps = _TEST_DEPS,
    packages = _TEST_PACKAGES,
    visibility = ["PUBLIC"],
)

_TEST_COMMON_DEPS = _TEST_DEPS + [":test-lib"]

haskell_test(
    name = "channel",
    srcs = {"ChannelTest.hs": "test/ChannelTest.hs"},
    main = "ChannelTest",
    deps = _TEST_COMMON_DEPS,
    packages = _TEST_PACKAGES,
)

