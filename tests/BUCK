haskell_test(
    name = "includes",
    srcs = thrift_srcs(
        name = "includes",
        thrift_files = {
        "if/A.thrift": [
            "A/Types.hs",
        ],
        "if/B.thrift": [
            "B/Types.hs",
        ],
        "if/C.thrift": [
            "C/Types.hs",
        ],
        "if/D.thrift": [
            "D/Types.hs",
        ],
        "if/E.thrift": [
            "E/Types.hs",
        ],
    },
        # A/B/C/D/E all see each other automatically - every file in the
        # same thrift_files dict does (see thrift_srcs()'s own comment).
        srcs = {"IncludesTest.hs": "IncludesTest.hs"},
    ),
    main = "IncludesTest",
    linker_flags = ["-threaded"],
    deps = _COMMON_DEPS,
    packages = _COMMON_PACKAGES,
)

