load("//buck2:haskell.bzl", "haskell_test")
load("//buck2:thrift.bzl", "thrift_srcs", "thrift_srcs_export")
# Exported for thrift-lib's own test-lib (its test-suite HsTest.Types is
# generated from if/hs_test.thrift, which lives here, not under
# hsthrift/lib) - see hsthrift/lib/BUCK.

export_file(
    name = "hs_test.thrift",
    src = "if/hs_test.thrift",
    visibility = ["PUBLIC"],
)

# hs_include'd verbatim into the generated Types.hs by thrift-compiler -
# a thrift_srcs_export() rather than a plain export_file() so lib/BUCK's
# test-lib can `deps` on it the same way as any other thrift dependency
# (thrift_compile()'s `deps` needs the ThriftSrcsInfo provider, which only
# thrift_srcs_export()/thrift_srcs() targets carry).
thrift_srcs_export(
    name = "hs_test_instances.hs",
    srcs = {"if/hs_test_instances.hs": "if/hs_test_instances.hs"},
    visibility = ["PUBLIC"],
)

# Same deal: monoid.thrift/huge.thrift each `hs_include` a raw .hs file
# sitting next to them, so each gets a `deps`-able collector too.
thrift_srcs_export(
    name = "instances.hs",
    srcs = {"if/instances.hs": "if/instances.hs"},
)

thrift_srcs_export(
    name = "huge.hs",
    srcs = {"if/huge.hs": "if/huge.hs"},
)

_COMMON_DEPS = [
    "//common/github:fb-stubs",
    "//compiler:thrift-compiler-lib",
    "//lib:test-helpers",
    "//lib:thrift-lib",
]

_COMMON_PACKAGES = [
    "HUnit",
    "QuickCheck",
    "STMonadTrans",
    "aeson",
    "bytestring",
    "containers",
    "data-default",
    "deepseq",
    "either",
    "ghc-prim",
    "hashable",
    "hspec",
    "hspec-contrib",
    "text",
    "transformers",
    "unordered-containers",
    "vector",
]

# Shared by every test-suite below that uses custom field/struct annotations
# (matches how each cabal test-suite independently lists these as
# other-modules - no shared library, so each binary regenerates them).
_ANNOTATIONS = {
    "thrift/annotation/haskell.thrift": ["Facebook/Thrift/Annotation/Haskell/Haskell/Types.hs"],
    "thrift/annotation/thrift.thrift": ["Facebook/Thrift/Annotation/Thrift/Thrift/Types.hs"],
    "thrift/annotation/scope.thrift": ["Scope/Types.hs"],
}

haskell_test(
    name = "add-prefix",
    srcs = thrift_srcs(
        name = "add-prefix",
        thrift_files = dict(_ANNOTATIONS, **{
            "if/hs_prefix.thrift": [
                "HsPrefix/Types.hs",
            ],
        }),
        deps = ["//:annotations"],
        srcs = {"AddPrefixTest.hs": "AddPrefixTest.hs"},
    ),
    main = "AddPrefixTest",
    linker_flags = ["-threaded"],
    deps = _COMMON_DEPS,
    packages = _COMMON_PACKAGES,
)

