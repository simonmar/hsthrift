load("//buck2:cxx.bzl", "cxx_library")
load("@prelude//third-party:pkgconfig.bzl", "external_pkgconfig_library")
load("cxx-files.bzl", "cxx_files")

# pkgconfig dependencies match those in folly-clib.cabal
external_pkgconfig_library(
    name = "fmt",
)

external_pkgconfig_library(
    name = "gflags",
)

external_pkgconfig_library(
    name = "glog",
    package = "libglog",
    deps = [":gflags"],
)

external_pkgconfig_library(
    name = "openssl",
)

external_pkgconfig_library(
    name = "unwind",
    package = "libunwind",
)

external_pkgconfig_library(
    name = "event",
    package = "libevent",
)

cxx_library(
    name = "folly-clib",
    srcs = cxx_files,  # generated by `make setup-folly`
    preprocessor_flags = [
        "-DFOLLY_HAVE_LIBGFLAGS=1",
        "-DFOLLY_USE_LIBCPP=0",
    ],
    include_directories = [
        "folly",
        "folly/_build",
        "fast_float-8.0.0/include",
    ],
    public_include_directories = [
        "folly",
        "folly/_build",
        "fast_float-8.0.0/include",
    ],
    exported_linker_flags = [
        "-lstdc++",
        "-lboost_filesystem",
        "-lboost_program_options",
        "-lboost_context",
        "-laio",
        "-lsodium",
        "-latomic",
    ],
    exported_deps = [
        ":fmt",
        ":glog",
        ":openssl",
        ":unwind",
        ":event",
    ],
    visibility = ["PUBLIC"],
)
