load("//buck2:cxx.bzl", "cxx_library")
load("cxx-files.bzl", "cxx_files")

cxx_library(
    name = "folly-clib",
    srcs = cxx_files,  # generated by `make setup-folly`
    preprocessor_flags = [
        "-DFOLLY_HAVE_LIBGFLAGS=1",
        "-DFOLLY_USE_LIBCPP=0",
    ],
    include_directories = [
        "folly",
        "folly/_build",
        "fast_float-8.0.0/include",
    ],
    public_include_directories = [
        "folly",
        "folly/_build",
        "fast_float-8.0.0/include",
    ],
    exported_linker_flags = [
        "-lstdc++",
        "-lboost_filesystem",
        "-lboost_program_options",
        "-lboost_context",
        "-lfmt",
        "-lglog",
        # glog's own DT_NEEDED dependency (see hsthrift/common/util/BUCK's
        # fb-util-cxx comment) - a static link needs it spelled out too.
        "-lgflags",
        "-lssl",
        "-lcrypto",
        "-lsnappy",
        "-lunwind",
        "-lzstd",
        "-lbz2",
        "-llz4",
        "-levent",
        "-lz",
        "-laio",
        "-lsodium",
        "-latomic",
    ],
    visibility = ["PUBLIC"],
)
